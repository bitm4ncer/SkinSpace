  <Window id="main" position="Center">
    <Layout id="l_eq" width="1098" height="788">
      <!-- Task 4: hier entsteht das EQ-Layout (l_eq) -->
      <Image id="eq.bg" image="head.png" action="move"/>
      <Button id="eq.back" x="202" y="464" up="EQ_01_DF.png" action="main.setLayout(l_closed)" tooltiptext="Back (Platzhalter)"/>

    </Layout>
    <Layout id="l_pl" width="1098" height="788">
      <!-- Task 5: hier entsteht das Playlist-Layout (l_pl) -->
      <Image id="pl.bg" image="head.png" action="move"/>
      <Button id="pl.back" x="202" y="464" up="PL_01_DF.png" action="main.setLayout(l_closed)" tooltiptext="Back (Platzhalter)"/>

    </Layout>
    <Layout id="l_both" width="1098" height="788">
      <!-- Task 6: hier entsteht das Kombi-Layout (l_both) -->
      <Image id="both.bg" image="head.png" action="move"/>
      <Button id="both.back" x="202" y="464" up="viz_drop_L_01_default.png" action="main.setLayout(l_closed)" tooltiptext="Back (Platzhalter)"/>

    </Layout>
    <Layout id="l_closed" width="1098" height="788">
      <!-- l_closed â€” Geschlossener Zustand. Koordinaten = Original (headspace.wms), Kopf-Offset 261,0 bereits eingerechnet. -->
      <!-- Zeichenreihenfolge = spÃ¤tere Elemente liegen oben (wird im Ladetest verifiziert). -->

      <!-- ==== Screen-Hintergrund + Ohren (liegen UNTER dem Kopf) ==== -->
      <Image id="cl.vidbkgd" x="540" y="118" image="vid_bkgd.png"/>
      <Image id="cl.eq.ear" x="414" y="172" image="left_ear.png"/>
      <Image id="cl.eq.drawerTop" x="582" y="172" image="left_drawer_top.png"/>
      <Image id="cl.eq.drawerBottom" x="582" y="472" image="left_drawer_bottom.png"/>
      <Image id="cl.eq.drawerRight" x="916" y="172" image="left_drawer_right.png"/>
      <Button id="cl.eq.handle" x="430" y="304"
              up="L_drwr_open_01_default.png" over="L_drwr_open_02_rollover.png" down="L_drwr_open_03_down.png"
              action="main.setLayout(l_eq)" tooltiptext="Open graphic equalizer controls"/>
      <Image id="cl.pl.drawerLeft" x="554" y="172" image="right_drawer_left.png"/>
      <Image id="cl.pl.drawerTop" x="580" y="172" image="right_drawer_top.png"/>
      <Image id="cl.pl.drawerBottom" x="580" y="472" image="right_drawer_bottom.png"/>
      <Image id="cl.pl.ear" x="924" y="172" image="right_ear.png"/>
      <Button id="cl.pl.handle" x="1046" y="302"
              up="R_drwr_open_01_default.png" over="R_drwr_open_02_rollover.png" down="R_drwr_open_03_down.png"
              action="main.setLayout(l_pl)" tooltiptext="Open playlist"/>

      <!-- ==== Kopf (zichbar) ==== -->
      <Image id="cl.head" x="522" y="0" image="head.png" action="move"/>

      <!-- ==== Fenstersteuerung auf der Stirn ==== -->
      <Button id="cl.min" x="724" y="8"
              up="minimize_close_01_default.png.min" over="minimize_close_02_rollover.png.min" down="minimize_close_03_down.png.min"
              action="vlc.minimize()" tooltiptext="Minimize"/>
      <Button id="cl.close" x="754" y="8"
              up="minimize_close_01_default.png.close" over="minimize_close_02_rollover.png.close" down="minimize_close_03_down.png.close"
              action="vlc.quit()" tooltiptext="Close"/>

      <!-- ==== Transport (prev/play/stop/next) + Pause-Overlay ==== -->
      <Button id="cl.prev" x="620" y="64"
              up="play_controls_01_default.png.prev" over="play_controls_02_rollover.png.prev" down="play_controls_03_down.png.prev"
              action="playlist.previous()" tooltiptext="Previous"/>
      <Button id="cl.play" x="670" y="64"
              up="play_controls_01_default.png.play" over="play_controls_02_rollover.png.play" down="play_controls_03_down.png.play"
              action="vlc.play()" tooltiptext="Play"/>
      <Button id="cl.stop" x="722" y="64"
              up="play_controls_01_default.png.stop" over="play_controls_02_rollover.png.stop" down="play_controls_03_down.png.stop"
              action="vlc.stop()" tooltiptext="Stop"/>
      <Button id="cl.next" x="772" y="64"
              up="play_controls_01_default.png.next" over="play_controls_02_rollover.png.next" down="play_controls_03_down.png.next"
              action="playlist.next()" tooltiptext="Next"/>
      <Button id="cl.pause" x="670" y="64"
              up="pause_01_default.png" over="pause_02_rollover.png" down="pause_03_down.png"
              visible="vlc.isPlaying" action="vlc.pause()" tooltiptext="Pause"/>

      <!-- ==== Kinn-Bedienelemente ==== -->
      <Button id="cl.eqbtn" x="552" y="428"
              up="EQ_01_DF.png" over="EQ_02_RV.png" down="EQ_03_Dwn.png"
              action="main.setLayout(l_eq)" tooltiptext="Open graphic equalizer controls"/>
      <Button id="cl.plbtn" x="930" y="428"
              up="PL_01_DF.png" over="PL_02_RV.png" down="PL_03_Dwn.png"
              action="main.setLayout(l_pl)" tooltiptext="Open playlist"/>
      <Image id="cl.seekbg" x="600" y="446" image="progressbar.png"/>
      <Slider id="cl.seek" x="600" y="446" points="(18,8),(308,8)" value="time"
              up="thumb_01_default.png" over="thumb_02_rollover.png" down="thumb_03_down.png"
              tooltiptext="Seek"/>
      <Button id="cl.theme" x="724" y="464"
              up="themebutton_01_default.png" over="themebutton_02_rollover.png" down="themebutton_03_down.png"
              action="dialogs.changeSkin()" tooltiptext="Choose another skin"/>

    </Layout>
